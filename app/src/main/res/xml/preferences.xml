<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="服务设置"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="service_enabled"
            android:title="启用辅助服务"
            android:summary="总开关，关闭后将停止所有功能"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="auto_recognition"
            android:title="自动识别"
            android:summary="自动检测棋局变化并更新"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:key="recognition_interval"
            android:title="识别间隔(毫秒)"
            android:summary="两次自动识别之间的间隔"
            android:min="500"
            android:max="5000"
            android:defaultValue="2000"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="AI引擎设置"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="ai_provider"
            android:title="AI提供商"
            android:summary="选择AI引擎"
            android:entries="@array/ai_provider_entries"
            android:entryValues="@array/ai_provider_values"
            android:defaultValue="LOCAL"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:key="engine_depth"
            android:title="本地引擎搜索深度"
            android:summary="搜索深度越大计算越强，但速度越慢"
            android:min="1"
            android:max="8"
            android:defaultValue="4"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="云端AI配置"
        app:iconSpaceReserved="false">

        <EditTextPreference
            android:key="api_url"
            android:title="API地址"
            android:summary="兼容OpenAI接口的API地址"
            android:dialogTitle="完整的API URL"
            android:defaultValue="https://api.openai.com/v1/chat/completions"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="api_key"
            android:title="API Key"
            android:summary="您的API密钥"
            android:dialogTitle="输入API Key"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="model_name"
            android:title="模型名称"
            android:summary="AI模型名称"
            android:dialogTitle="模型名称如: gpt-4o"
            android:defaultValue="gpt-4o"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="高级设置"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="manual_board_rect"
            android:title="手动设置棋盘区域"
            android:summary="开启后可在屏幕上手动框选棋盘区域"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
