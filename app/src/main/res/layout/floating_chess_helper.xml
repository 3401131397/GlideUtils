<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_container"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC1A1A2E"
    android:padding="10dp"
    android:elevation="8dp">

    <!-- 头部栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="象棋AI"
            android:textSize="12sp"
            android:textColor="#E94560"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_minimize"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:text="─"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </RelativeLayout>

    <!-- 步数 -->
    <TextView
        android:id="@+id/tv_move_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="步数: 0"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:paddingTop="4dp" />

    <!-- 当前行棋方 -->
    <TextView
        android:id="@+id/tv_current_turn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="红方走棋"
        android:textSize="13sp"
        android:textColor="#D32F2F"
        android:textStyle="bold"
        android:paddingTop="2dp" />

    <!-- 最佳着法 -->
    <TextView
        android:id="@+id/tv_best_move"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="建议: --"
        android:textSize="18sp"
        android:textColor="#E94560"
        android:textStyle="bold"
        android:background="#33000000"
        android:padding="6dp"
        android:layout_marginTop="4dp" />

    <!-- 评分 -->
    <TextView
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="评分: 0"
        android:textSize="13sp"
        android:textColor="#1976D2"
        android:paddingTop="4dp" />

    <!-- 详细信息面板 -->
    <LinearLayout
        android:id="@+id/panel_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_fen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="8sp"
            android:textColor="#888888"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="4dp" />
    </LinearLayout>

</LinearLayout>
